{
  "name": "rust-visualizer-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "proto": "pbjs -t static-module -w es6 --no-create --no-verify --no-convert --no-delimited -o web/gen/graph.js proto/graph.proto && pbts -o web/gen/graph.d.ts web/gen/graph.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --test scripts/*_tests.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "protobufjs-cli": "^1.1.3",
    "typescript": "^5.9.0"
  }
}
